# Copy to .env for local development. Never commit the real .env file.
MONGODB_URI=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Server-only API origin used by Next.js server code; never expose as NEXT_PUBLIC_.
FIXMATE_SERVER_API_URL=http://localhost:5000

# Server-only shared secret used by the Better Auth registration hook when it
# provisions the authoritative application user in Express. Never expose this value.
FIXMATE_PROVISIONING_SECRET=
