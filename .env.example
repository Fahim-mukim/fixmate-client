# Copy to .env for local development. Never commit the real .env file.
MONGODB_URI=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Server-only API origin used by Next.js server code; never expose as NEXT_PUBLIC_.
FIXMATE_SERVER_API_URL=http://localhost:5000

# Server-only shared secret used by the Better Auth registration hook when it
# provisions the authoritative application user in Express. Never expose this value.
FIXMATE_PROVISIONING_SECRET=

# Isolated authentication test mode (Phase 5E). Set FIXMATE_TEST_MODE=true only
# when every value below is configured for the separate fixmate_auth_test database.
# These names are intentionally commented out; do not uncomment them in normal mode.
# FIXMATE_TEST_MODE=true
# FIXMATE_TEST_MONGODB_URI=
# FIXMATE_TEST_DATABASE_NAME=fixmate_auth_test
# FIXMATE_TEST_PROVISIONING_SECRET=
# BETTER_AUTH_TEST_URL=http://localhost:3000
# BETTER_AUTH_TEST_SECRET=
# FIXMATE_TEST_SERVER_API_URL=http://localhost:5000
